# ============================================================================
# Environment variables template. Copy to `.env.local` and fill with real values.
# `.env.local` is git-ignored and is the single source of truth for local dev.
# NEVER commit real secrets. `NEXT_PUBLIC_` prefix ONLY for browser-safe values.
# ============================================================================

# ---- Database (Supabase Postgres, Singapore region) ------------------------
# DATABASE_URL: Pooled connection (Supabase pooler, Transaction mode, port 6543).
#   Used by the app at runtime via the Prisma pg driver adapter (Vercel serverless).
#   Append `?pgbouncer=true&connection_limit=1` for serverless.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: Direct connection (Supabase, Session mode, port 5432).
#   Used ONLY by Prisma Migrate / introspection — never at serverless runtime.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
